{
  "name": "auralis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Auralis — a fitness & health companion that makes Garmin Connect look ancient. Liquid-glass design.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node server/index.mjs\"",
    "dev:web": "vite",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "lint": "tsc --noEmit",
    "app": "concurrently -k -n vite,electron -c cyan,green \"vite\" \"ELECTRON_DEV=1 electron .\"",
    "app:preview": "npm run build && electron .",
    "app:build": "npm run build && electron-builder",
    "app:build:mac": "npm run build && electron-builder --mac",
    "app:build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "framer-motion": "^11.3.19",
    "garmin-connect": "^1.6.2",
    "lucide-react": "^0.428.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.1"
  },
  "build": {
    "appId": "com.auralis.health",
    "productName": "Auralis",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.healthcare-fitness",
      "icon": "build/icon.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  }
}
